{
    "name": "woocommerce/woocommerce-product-feed-for-openai",
    "description": "WooCommerce Product Feed for OpenAI",
    "homepage": "https://github.com/woocommerce/WooCommerce-Product-Feed-for-OpenAI",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "prefer-stable": true,
    "minimum-stability": "dev",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.2",
        "woocommerce/woocommerce-sniffs": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "sirbrillig/phpcs-variable-analysis": "^2.13",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Automattic\\WooCommerce\\ProductFeedForOpenAI\\": "src"
        }
    },
    "scripts": {
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "phpcbf": "phpcbf --standard=phpcs.xml.dist",
        "phpcs:check": "phpcs --standard=phpcs.xml.dist --report=summary",
        "phpcbf:fix": "phpcbf --standard=phpcs.xml.dist"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
